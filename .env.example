# ADMIN_PASSWORD: Password for the seeded admin account. Change this before deploying.
ADMIN_PASSWORD="change-me"

# SESSION_SECRET: Signs browser sign-in tokens. Set a long random value in production.
SESSION_SECRET="change-me"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public origin of this app, no trailing slash.
# Used in emails and invite links. Example: https://portal.example.org
# Local dev can leave this unset; links fall back to http://localhost:3000.
APP_URL=

# VITE_API_URL: Public origin of this API, no trailing slash.
# Required only when the UI is built for static hosting (GitHub Pages).
# Local `npm run dev` serves the UI and API together on port 3000, so leave this unset.
# Example: https://members-api.example.org
# On GitHub, set this as an Actions repository variable named VITE_API_URL. See README.md.
VITE_API_URL=

# SMTP Email Configuration
# Configure your outgoing SMTP mail server (e.g. Gmail, SendGrid, Amazon SES, Brevo, custom mail server)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Arabiyya Rovers Council <no-reply@arabiyyarovers.net>"

# Telegram Integration Configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID="@arabiyyarovers"
TELEGRAM_CHANNEL="@arabiyyascoutsbot"
TELEGRAM_ENABLED=false

# Firebase Admin service account.
# The API uses the Admin SDK, which bypasses firestore.rules.
# Provide the JSON itself, the same JSON base64-encoded, or a path to the JSON file.
# GOOGLE_APPLICATION_CREDENTIALS (a file path) works too.
# Without this, the server keeps data in memory and `npm run dev` still runs.
# Deploy firestore.rules only after a restart shows "Connected (Admin SDK)". See README.md.
FIREBASE_SERVICE_ACCOUNT=

