rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The API server uses the Firebase Admin SDK and bypasses these rules.
    // Browser clients must not read or write passwords, OTPs, applications, or settings.

    function signedInOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function noPrivilegeFields() {
      return !request.resource.data.keys().hasAny(['password', 'passwordHash', 'isAdmin']);
    }

    function roleNotEscalated() {
      return !('role' in request.resource.data)
        || (
          request.resource.data.role != 'Admin'
          && request.resource.data.role != 'Secretary'
        )
        || (
          resource != null
          && resource.data.role == request.resource.data.role
        );
    }

    // Owner profile mirror. Privilege and password fields are server-only.
    match /users/{userId} {
      allow read: if signedInOwner(userId);
      allow create, update: if signedInOwner(userId) && noPrivilegeFields() && roleNotEscalated();
      allow delete: if false;
    }

    // Published crew policy is public. Writes go through the API.
    match /policies/{policyId} {
      allow read: if true;
      allow write: if false;
    }

    match /otps/{otpId} {
      allow read, write: if false;
    }

    match /member_applications/{appId} {
      allow read, write: if false;
    }

    match /leader_applications/{appId} {
      allow read, write: if false;
    }

    match /settings/{settingId} {
      allow read, write: if false;
    }

    match /members/{memberId} {
      allow read, write: if false;
    }

    match /invitations/{invitationId} {
      allow read, write: if false;
    }

    match /profile_update_requests/{reqId} {
      allow read, write: if false;
    }

    match /events/{eventId} {
      allow read, write: if false;
    }

    match /attendance/{attendanceId} {
      allow read, write: if false;
    }

    match /announcements/{annId} {
      allow read, write: if false;
    }

    match /announcement_presets/{presetId} {
      allow read, write: if false;
    }

    match /meeting_minutes/{minId} {
      allow read, write: if false;
    }

    match /logbook_entries/{entryId} {
      allow read, write: if false;
    }

    match /system_health/{healthId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
